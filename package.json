{
  "name": "obsidian-oh-my-plan-board-plugin",
  "version": "0.1.0",
  "description": "Day-by-day checklist board for Obsidian, editable from the sidebar or from a CLI.",
  "type": "module",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc -noEmit -skipLibCheck"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  }
}
